<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main.master.cs" Inherits="UniversityLibrarySystem.Main" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%="\""+GetShortAboutUs()+"\""%> />
    <link rel="shortcut icon" type="image/x-icon" href="img/logo/favicon.png">
    <link rel="stylesheet" href="css/bootstrap.min.css">
    <link rel="stylesheet" href="css/owl.carousel.min.css">
    <link rel="stylesheet" href="css/slicknav.css">
    <link rel="stylesheet" href="css/animate.min.css">
    <link rel="stylesheet" href="css/magnific-popup.css">
    <link rel="stylesheet" href="css/fontawesome-all.min.css">
    <link rel="stylesheet" href="css/themify-icons.css">
    <link rel="stylesheet" href="css/slick.css">
    <link rel="stylesheet" href="css/nice-select.css">
    <link rel="stylesheet" href="css/style.css">

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>

    <header>
        <div class="header-area">
            <div class="main-header ">
                <div class="header-top ">
                    <div class="container">
                        <div class="row">
                            <div class="col-xl-12">
                                <div class="d-flex justify-content-between align-items-center flex-sm">
                                    <div class="header-info-left d-flex align-items-center">

                                        <div class="logo" style="font-size: large; color: #3f51b5;">
                                            <a href="/">
                                                <img src="img/logo/logo.png" alt="<%=Classes.SiteConfig.getSiteName() %>" />
                                            </a>
                                        </div>
                                        <form action="search" method="get" class="form-box">
                                            <input type="text" name="BookName"
                                                placeholder="جستجوی کتاب براساس نویسنده یا انتشارات">
                                            <div class="search-icon">
                                                <button class="ti-search search-btn"></button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="header-info-right d-flex align-items-center">
                                        <asp:MultiView ID="MultiViewBtns" ActiveViewIndex="0" runat="server">
                                            <asp:View runat="server">
                                                <a href="register" class="btn header-btn ml-5">ثبت نام</a>
                                                <a href="login" class="btn header-btn mr-5">ورود</a>
                                            </asp:View>
                                            <asp:View runat="server">
                                                <a href="Student/Books" class="btn header-btn">پنل دانشجو</a>
                                            </asp:View>
                                            <asp:View runat="server">
                                                <a href="Manager/Dashboard" class="btn header-btn">پنل مدیریت</a>
                                            </asp:View>
                                        </asp:MultiView>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="header-bottom  header-sticky">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-xl-12">

                                <div class="logo2">
                                    <a href="/">
                                        <img src="img/logo/logo.png" alt="<%=Classes.SiteConfig.getSiteName() %>"></a>
                                </div>

                                <div class="main-menu text-center d-none d-lg-block">
                                    <nav>
                                        <ul id="navigation" class="menu">
                                            <li><a href="/">صفحه اصلی</a></li>

                                            <li><a href="Categories">دسته بندی</a>

                                                <div class="megadrop">
                                                    <div class="mega-head">
                                                        <%=CategoriesNavbar() %>
                                                    </div>
                                                </div>
                                            </li>
                                            <li><a href="faq">سوالات متداول</a></li>
                                            <li><a href="contactus">تماس با ما</a></li>
                                            <li><a href="aboutus">درباره ما</a></li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>


                            <div class="col-xl-12">
                                <div class="mobile_menu d-block d-lg-none"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <main>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </main>
    <footer>
        <div class="footer-wrappper section-bg">
            <div class="footer-area footer-padding">
                <div class="container">
                    <div class="row justify-content-between">
                        <div class="col-xl-3 col-lg-3 col-md-3">
                            <div class="single-footer-caption mb-50">
                                <div class="single-footer-caption mb-30">

                                    <div class="logo" style="font-size: large; color: #3f51b5;">
                                        <a href="/">
                                            <img src="img/logo/logo.png" alt="<%=Classes.SiteConfig.getSiteName() %>" />
                                        </a>
                                    </div>

                                    <div class="footer-social">
                                        <strong><%=GetShortAboutUs() %></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-3">
                            <div class="single-footer-caption mb-50">
                                <div class="footer-tittle">
                                    <h4>دسته بندی</h4>
                                    <ul>
                                        <%=CategoriesGroup(1) %>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-3">
                            <div class="single-footer-caption mb-50">
                                <div class="footer-tittle">
                                    <h4>&nbsp;</h4>
                                    <ul>
                                        <%=CategoriesGroup(2) %>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-3">
                            <div class="single-footer-caption mb-50">
                                <div class="footer-tittle">
                                    <h4>راهنمای سایت</h4>
                                    <ul class="mb-20">
                                        <li><a href="category">دسته بندی</a></li>
                                        <li><a href="faq">سوالات متداول</a></li>
                                        <li><a href="contactus">تماس با ما</a></li>
                                        <li><a href="aboutus">درباره ما</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom-area">
                <div class="container">
                    <div class="footer-border">
                        <div class="row d-flex align-items-center">
                            <div class="col-xl-12 ">
                                <div class="footer-copy-right text-center">
                                    کپی رایت &copy; تمام حقوق محفوظ می باشد | طراحی شده توسط <a
                                        href="<%=Classes.SiteConfig.getDevLink() %>"
                                        style="color: rgb(0, 0, 0)" target="_blank" rel="nofollow noopener"><%=Classes.SiteConfig.getDevName() %></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div id="back-top" style="display: none;">
        <a title="Go to Top" href="#"><i class="fas fa-chevron-up"></i></a>
    </div>

    <script src="js/modernizr-3.5.0.min.js"></script>
    <script src="js/jquery-1.12.4.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.min.js"></script>

    <script src="js/owl.carousel.min.js"></script>
    <script src="js/slick.min.js"></script>
    <script src="js/jquery.slicknav.min.js"></script>

    <script src="js/wow.min.js"></script>
    <script src="js/jquery.magnific-popup.js"></script>
    <script src="js/jquery.nice-select.min.js"></script>
    <script src="js/jquery.counterup.min.js"></script>
    <script src="js/waypoints.min.js"></script>

    <script src="js/jquery.form.js"></script>
    <script src="js/jquery.validate.min.js"></script>
    <script src="js/jquery.ajaxchimp.min.js"></script>

    <script src="js/main.js"></script>
</body>
</html>
